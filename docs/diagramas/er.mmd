  VENTAS {
    int id PK
    text tipo_comprobante "BOLETA o FACTURA"
    text serie
    int correlativo
    int cliente_id FK
    int subtotal_centimos
    int igv_centimos
    int total_centimos
    text estado "EMITIDA o ANULADA"
  }
  VENTA_DETALLE {
    int id PK
    int venta_id FK
    int producto_id FK
    int cantidad
    int precio_unitario_centimos
    int importe_centimos
