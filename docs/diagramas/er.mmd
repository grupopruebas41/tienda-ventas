  PRODUCTOS ||--o{ VENTA_DETALLE : aparece_en
  CLIENTES {
    int id PK
    text tipo_documento "DNI o RUC"
    text numero_documento UK
    text nombre
    text email
    text telefono
    text direccion
  }
  PROVEEDORES {
    int id PK
    text ruc UK
    text razon_social
    text contacto
    text telefono
    text email
  }
  PRODUCTOS {
    int id PK
    text codigo UK
    text nombre
    text categoria
    int precio_centimos
    int stock
    int stock_minimo
    int proveedor_id FK
